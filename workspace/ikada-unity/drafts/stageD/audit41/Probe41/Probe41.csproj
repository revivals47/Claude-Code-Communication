<Project Sdk="Microsoft.NET.Sdk">
  <!-- #41 audit (worker3, AUDIT_41_42_W3.md): measure only. Built against ikada-sim-w3 (main 2750f49 + the FightHarness
       probe hook on the local branch w3/audit41-probe, never pushed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup><Sim>$(HOME)/Documents/ikada-sim-w3/pc</Sim></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Sim)/src/Ikada.Game/Ikada.Game.csproj" />
    <ProjectReference Include="$(Sim)/src/Ikada.Native/Ikada.Native.csproj" />
    <ProjectReference Include="$(Sim)/src/Ikada.Logic/Ikada.Logic.csproj" />
    <ProjectReference Include="$(Sim)/src/Ikada.Desktop/Ikada.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(Sim)/tests/Ikada.Tests/Ecology/FishingDay.cs" Link="Harness/FishingDay.cs" />
    <Compile Include="$(Sim)/tests/Ikada.Tests/Ecology/FishingDay.Diel.cs" Link="Harness/FishingDay.Diel.cs" />
    <Compile Include="$(Sim)/tests/Ikada.Tests/Ecology/FishingDay.Strike.cs" Link="Harness/FishingDay.Strike.cs" />
    <Compile Include="$(Sim)/tests/Ikada.Tests/Fight/FightHarness.cs" Link="Harness/FightHarness.cs" />
    <Compile Include="$(Sim)/tests/Ikada.Tests/Fight/FightPlayers.cs" Link="Harness/FightPlayers.cs" />
    <Compile Include="$(Sim)/tests/Ikada.Tests/Native/NativeLib.cs" Link="Harness/NativeLib.cs" />
    <Compile Include="$(Sim)/tests/Ikada.Tests/ParallelCap.cs" Link="Harness/ParallelCap.cs" />
  </ItemGroup>
</Project>
